{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scamguard",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "scamguard-lan",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "scamguard-qatom",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "RAIL=qatom",
        ".venv/bin/uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "scamguard-tunnel",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "HOSTED=1",
        "RAIL=qatom",
        ".venv/bin/uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "scamguard-check",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
