# Copy to .env and fill in what you have. Everything is optional; the demo runs with none of it.

# --- Demo ---
DEMO_MODE=1                 # enables Start over, Skip 24h and /api/demo-config (hands the family key to the demo page)
# FAMILY_KEY=               # the family PIN; unset = random 6 digits each start (printed in the server log)
GRANDMA_NAME=Margaret
DAUGHTER_NAME=Sarah

# --- Payment rail: mock (practice) or qatom ---
RAIL=mock
# QATOM_CLIENT_ID=          # the user's own client credentials (pays from the agent wallet, no 2FA)
# QATOM_CLIENT_SECRET=
# SCAMCHECK_SECRET=         # shared secret Qatom sends to /api/agents/scamcheck (dispatch params)
# QATOM_UNMAPPED=practice   # payees with no qatom_item in payees.json settle on the practice rail (or: fail)

# --- LLM through Backboard (falls back to the built-in parser on any error) ---
# BACKBOARD_API_KEY=
# BACKBOARD_PROVIDER=openai
# BACKBOARD_MODEL=gpt-4o
# BACKBOARD_TIMEOUT=10       # seconds before falling back to the parser
